#!/bin/sh /etc/rc.common
# procd service for the OpenWrtFi controller (mainrouter only).
START=99
USE_PROCD=1

start_service() {
	# Private rpcd HTTP bridge for gateway authentication/actions. The router's public
	# LuCI listener on 80/443 is intentionally blocked to locally-originated traffic by
	# luciguard, so OpenWrtFi owns a loopback-only listener on an unrelated port instead.
	procd_open_instance rpcd
	procd_set_param command /usr/sbin/uhttpd -f -p 127.0.0.1:8089 -h /tmp -D -S -u /ubus -U /var/run/ubus/ubus.sock -n 3 -N 20 -t 30 -T 5 -k 5
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance controller
	procd_set_param command /usr/bin/openwrtfi --listen 0.0.0.0:8088 --config /etc/openwrtfi.json
	procd_set_param env RUST_LOG=info
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	# Hard ceiling so a bug can never starve AdGuardHome on the 495 MB box.
	procd_set_param limits as="64000000 64000000"
	procd_close_instance
}
